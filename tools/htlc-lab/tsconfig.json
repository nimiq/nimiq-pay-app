{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
