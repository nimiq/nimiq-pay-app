# Copy to .env and fill in what you need. Unset values only break the feature that uses them.

# Feature flags
VITE_ENABLE_MINI_APPS=true

# EVM RPC endpoints passed to Mini Apps. Polygon falls back to a public RPC when empty.
VITE_ETHEREUM_RPC_URL=
VITE_POLYGON_RPC_URL=
VITE_ARBITRUM_RPC_URL=
VITE_OPTIMISM_RPC_URL=
VITE_BASE_RPC_URL=
VITE_BNB_RPC_URL=
VITE_SEPOLIA_RPC_URL=

# Walkie Talkie (requests fail when unset)
VITE_WALKIE_TALKIE_URL=
VITE_WALKIE_TALKIE_API_KEY=

# Bake mock data into the build (store screenshots only)
# VITE_MOCK_DATA=true

# Release only (maintainers)
GITHUB_TOKEN=

APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_CONTENT=

APP_IDENTIFIER=com.nimiq.pay

# Name of the file containing the Google Play service account JSON key. The file must be placed in the root of the project.
GOOGLE_PLAY_JSON_KEY_FILE=

BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
