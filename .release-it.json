{
  "verbose": 2,
  "hooks": {
    "before:init": "node -e \"if (!process.env.GITHUB_TOKEN?.trim()) { console.error('GITHUB_TOKEN is required to publish the release and upload assets. Set it in .env or the environment.'); process.exit(1); }\"",
    "after:bump": [
      "node scripts/generate-changelog.mjs ${version}",
      "pnpm build:ios",
      "pnpm build:android"
    ],
    "after:github:release": [
      "node scripts/browserstack-upload.js"
    ],
    "after:release": [
      "rm builds/android/NimiqPay-*.aab",
      "rm builds/android/NimiqPay-*.apk",
      "rm builds/ios/NimiqPay-*.ipa",
      "rm builds/ios/NimiqPay-*.zip",
      "rm builds/ios/NimiqPay-*.app.tgz"
    ]
  },
  "git": {
    "commitMessage": "🚀 Release v${version}"
  },
  "github": {
    "release": true,
    "releaseNotes": "node scripts/generate-changelog.mjs ${version} --print-latest",
    "assets": [
      "builds/ios/NimiqPay-${version}.ipa",
      "builds/ios/NimiqPay-${version}.app.tgz",
      "builds/android/NimiqPay-${version}.aab",
      "builds/android/NimiqPay-${version}.apk"
    ]
  }
}
