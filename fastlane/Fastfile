ios_path = "./ios/App/"
project = ios_path + "App.xcodeproj"
workspace = ios_path + "App.xcworkspace"
gradle_file_path = "./android/app/build.gradle"
scheme = "App"
package = read_json(json_path: "./package.json")
version = package[:version]
android_project_dir = "./android"


platform :ios do
  desc "Build a new beta version for testing"
  lane :beta do
    sh "cd .. && ionic cap sync ios --prod"

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
    )
    
    previous_build_number_beta = latest_testflight_build_number(app_identifier:ENV["APP_IDENTIFIER"])
    previous_build_number_prod = app_store_build_number(app_identifier: ENV["APP_IDENTIFIER"])
    previous_build_number = [previous_build_number_beta, previous_build_number_prod].max
    current_build_number = previous_build_number + 1

    increment_build_number(xcodeproj: project,  build_number: current_build_number)
    increment_version_number(xcodeproj: project, version_number: version)

    # Generate the .app file
    build_app(
      clean: true, 
      scheme: scheme, 
      workspace: workspace,
      output_directory: "builds/ios",
      output_name: "NimiqPay-#{version}",
      export_method: "ad-hoc",
      skip_package_ipa: true,
      skip_archive: true,
      destination: "generic/platform=iOS Simulator",
      derived_data_path: "builds/ios/bundle",
      export_options: {
        provisioningProfiles: {
          "com.nimiq.pay" => "Nimiq Pay iOS Testing"
        }
      }
      )
    sh "tar -C ../builds/ios/bundle/Build/Products/Debug-iphonesimulator -czf ../builds/ios/NimiqPay-#{version}.app.tgz App.app"

    # Generate the .ipa file
    build_app(
      clean: true, 
      scheme: scheme, 
      workspace: workspace,
      output_directory: "builds/ios",
      output_name: "NimiqPay-#{version}",
      export_method: "ad-hoc",
      export_options: {
        provisioningProfiles: {
          "com.nimiq.pay" => "Nimiq Pay iOS Testing"
        }
      }
      )
  end

  desc "Generate App Store screenshots via Maestro (mock data baked in)"
  lane :screenshots do
    screenshot_devices = ["iPhone 17 Pro Max"]
    locale = "en-US"
    out_dir = "screenshots/#{locale}"

    # Bake mock-data mode into the build so the UI shows deterministic fixtures.
    # Must be a development-mode build (import.meta.env.DEV === true) — mock is dev-gated and can
    # never activate in a production (--prod) build. See src/lib/mock-mode.ts.
    sh "cd .. && NODE_ENV=development VITE_MOCK_DATA=true pnpm exec vite build --mode development && npx cap sync ios"

    build_app(
      scheme: scheme,
      workspace: workspace,
      skip_package_ipa: true,
      skip_archive: true,
      destination: "generic/platform=iOS Simulator",
      derived_data_path: "builds/ios/screenshots",
    )
    app_path = "builds/ios/screenshots/Build/Products/Debug-iphonesimulator/App.app"

    sh "mkdir -p #{out_dir}"
    screenshot_devices.each do |device|
      udid = sh("xcrun simctl list devices available | grep '#{device} (' | head -1 | grep -oE '[0-9A-F-]{36}'").strip
      UI.user_error!("Simulator '#{device}' not found. Create it in Xcode > Devices and Simulators.") if udid.empty?

      sh "xcrun simctl boot #{udid} || true"
      sh "xcrun simctl bootstatus #{udid} -b"
      sh "xcrun simctl status_bar #{udid} override --time '13:37' --batteryState charged --batteryLevel 100 --cellularMode active --cellularBars 4 --wifiBars 3"
      sh "xcrun simctl install #{udid} ../#{app_path}"

      tmp_dir = "/tmp/nimiq-pay-screens/#{udid}"
      sh "rm -rf #{tmp_dir} && mkdir -p #{tmp_dir}"
      sh "cd .. && maestro --device #{udid} test -e APP_ID=com.nimiq.pay -e OUTPUT_DIR=#{tmp_dir} nimiq-pay-tests/screenshots/store_screenshots.yaml"

      # Drop this device's previous shots so renamed/removed screens don't linger as stale files
      Dir.glob("#{out_dir}/#{device}-*.png").each { |old| FileUtils.rm(old) }
      Dir.glob("#{tmp_dir}/*.png").each do |png|
        FileUtils.cp(png, "#{out_dir}/#{device}-#{File.basename(png)}")
      end

      sh "xcrun simctl status_bar #{udid} clear"
      sh "xcrun simctl shutdown #{udid}"
    end

    UI.success("Screenshots saved to fastlane/#{out_dir}")
  end
end

platform :android do
  desc "Build a new beta version for testing"
  lane :beta do
    sh "cd .. && ionic cap sync android --prod"

    previous_build_number_internal = google_play_track_version_codes(json_key: ENV['GOOGLE_PLAY_JSON_KEY_FILE'], package_name: ENV['APP_IDENTIFIER'], track: "internal")[0]
    previous_build_number_alpha = google_play_track_version_codes(json_key: ENV['GOOGLE_PLAY_JSON_KEY_FILE'], package_name: ENV['APP_IDENTIFIER'], track: "alpha")[0]
    previous_build_number_beta = google_play_track_version_codes(json_key: ENV['GOOGLE_PLAY_JSON_KEY_FILE'], package_name: ENV['APP_IDENTIFIER'], track: "beta")[0]
    previous_build_number_prod = google_play_track_version_codes(json_key: ENV['GOOGLE_PLAY_JSON_KEY_FILE'], package_name: ENV['APP_IDENTIFIER'], track: "production")[0]

    previous_build_number = [previous_build_number_internal, previous_build_number_alpha, previous_build_number_beta, previous_build_number_prod].max
    current_build_number = previous_build_number + 1

    android_set_version_code(version_code: current_build_number, gradle_file: gradle_file_path)
    android_set_version_name(version_name: version, gradle_file: gradle_file_path )
    # Generate the .aab bundle
    gradle(
          task: 'clean bundle',
          build_type: 'Debug',
          project_dir: android_project_dir,
        )
    # Move the generated bundle to the builds folder
    sh "mv #{lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]} ../builds/android/NimiqPay-#{version}.aab"

    # Generate the .apk file
    gradle(
          task: 'clean assemble',
          build_type: 'Debug',
          project_dir: android_project_dir,
        )
    # Move the generated apk file to the builds folder
    sh "mv #{lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]} ../builds/android/NimiqPay-#{version}.apk"
  end

  desc "Generate Play Store screenshots via Maestro (mock data baked in). Requires one booted emulator."
  lane :screenshots do
    locale = "en-US"
    out_dir = "screenshots/android/#{locale}"

    # Bake mock-data mode into the build so the UI shows deterministic fixtures.
    # Must be a development-mode build (import.meta.env.DEV === true) — mock is dev-gated and can
    # never activate in a production (--prod) build. See src/lib/mock-mode.ts.
    sh "cd .. && NODE_ENV=development VITE_MOCK_DATA=true pnpm exec vite build --mode development && npx cap sync android"

    gradle(
      task: "assemble",
      build_type: "Debug",
      project_dir: android_project_dir,
    )
    apk = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]

    sh "adb wait-for-device"
    sh "adb install -r #{apk}"

    # Demo-mode status bar: 13:37, full battery/wifi, no notifications
    sh "adb shell settings put global sysui_demo_allowed 1"
    sh "adb shell settings put system time_12_24 24"
    sh "adb shell am broadcast -a com.android.systemui.demo -e command enter"
    sh "adb shell am broadcast -a com.android.systemui.demo -e command clock -e hhmm 1337"
    sh "adb shell am broadcast -a com.android.systemui.demo -e command battery -e level 100 -e plugged false"
    sh "adb shell am broadcast -a com.android.systemui.demo -e command network -e wifi show -e level 4 -e fully true"
    sh "adb shell am broadcast -a com.android.systemui.demo -e command network -e mobile hide"
    sh "adb shell am broadcast -a com.android.systemui.demo -e command notifications -e visible false"

    tmp_dir = "/tmp/nimiq-pay-screens/android"
    sh "rm -rf #{tmp_dir} && mkdir -p #{tmp_dir} #{out_dir}"
    sh "cd .. && maestro test -e APP_ID=com.nimiq.pay.debug -e OUTPUT_DIR=#{tmp_dir} nimiq-pay-tests/screenshots/store_screenshots.yaml"

    # Drop previous shots so renamed/removed screens don't linger as stale files
    Dir.glob("#{out_dir}/Phone-*.png").each { |old| FileUtils.rm(old) }
    Dir.glob("#{tmp_dir}/*.png").each do |png|
      FileUtils.cp(png, "#{out_dir}/Phone-#{File.basename(png)}")
    end

    sh "adb shell am broadcast -a com.android.systemui.demo -e command exit"
    UI.success("Screenshots saved to fastlane/#{out_dir}")
  end
end
