{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // The following settings are copied from `trust-web3-provider/tsconfig.json`
    "lib": ["ES2020", "DOM"],
    "target": "ES2020",
    "module": "ES2020",
    "allowJs": false,
    "composite": true,

    // Bundler mode
    "moduleResolution": "node",

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}

