{
  "name": "nimiq-pay",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "description": "An Ionic project",
  "scripts": {
    "dev:android": "ionic cap run android --livereload --external --watch",
    "dev:a": "pnpm run dev:android",
    "dev:ios": "ionic cap run ios --livereload --external --watch",
    "dev:i": "pnpm run dev:ios",
    "dev": "vite",
    "devtools": "vue-devtools",
    "dt": "pnpm run devtools",
    "build:web": "pnpm i18n:extract && vue-tsc && vite build",
    "build:ios": "dotenv bundle exec fastlane ios beta",
    "build:android": "dotenv bundle exec fastlane android beta",
    "release": "pnpm i18n:extract && ionic cap build --prod",
    "release:beta": "dotenv release-it",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "i18n:extract": "node ./node_modules/webpack-i18n-tools/index.js ./src/i18n/en.po",
    "i18n:push": "./weblate-sync.sh --pushSource",
    "i18n:pull": "./weblate-sync.sh --pullTranslations=de,es,fr,pt",
    "i18n:sync": "pnpm i18n:extract && pnpm i18n:push && pnpm i18n:pull"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^5.4.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capawesome/capacitor-screen-orientation": "^5.0.1",
    "@nimiq/fastspot-api-v1": "github:nimiq/fastspot-api#7d40ede12f86e9f9523d61c19ad99fc1663f5898",
    "@nimiq/fastspot-api-v2": "github:nimiq/fastspot-api#3ef81c74836f14e534443b6ea6d98ed4041f6e63",
    "@nimiq/utils": "^0.9.3",
    "@nimiq/vue3-components": "github:nimiq/vue3-components#build/full",
    "@vueuse/core": "^10.9.0",
    "@vueuse/integrations": "^10.9.0",
    "fuse.js": "^7.0.0",
    "jssha": "^3.3.1",
    "libphonenumber-js": "^1.10.61",
    "light-bolt11-decoder": "^3.0.0",
    "pinia": "^2.1.7",
    "qr-scanner-wechat": "^0.1.3",
    "radix-vue": "^1.7.2",
    "vue-virtual-scroller": "2.0.0-beta.8",
    "youtube-player": "^5.6.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "1.0.0-beta.29",
    "@capacitor-community/sqlite": "^5.7.2",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/clipboard": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@ionic/cli": "^7.2.0",
    "@ionic/core": "8.0.0",
    "@ionic/vue": "8.0.0",
    "@ionic/vue-router": "8.0.0",
    "@nimiq/core-web": "^1.6.2",
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/youtube-player": "^5.5.11",
    "@vitejs/plugin-legacy": "^5.3.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/devtools": "^7.1.2",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.5",
    "autoprefixer": "^10.4.19",
    "cypress": "^13.8.0",
    "dotenv-cli": "^7.4.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.25.0",
    "ionicons": "^7.3.1",
    "jeep-sqlite": "2.5.6",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.38",
    "release-it": "^17.2.0",
    "tailwindcss": "^3.4.3",
    "tailwindcss-nimiq-theme": "^0.2.2",
    "terser": "^5.30.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "vite-plugin-checker": "^0.6.4",
    "vite-plugin-pwa": "^0.17.5",
    "vitest": "^1.5.0",
    "vue": "^3.4.24",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.3.2",
    "vue-tsc": "^1.8.27",
    "webpack-i18n-tools": "github:nimiq/webpack-i18n-tools"
  },
  "pnpm": {
    "overrides": {
      "jeep-sqlite": "2.5.6"
    }
  }
}
