{
  "name": "nimiq-pay",
  "type": "module",
  "version": "2.2.5",
  "private": true,
  "description": "An Ionic project",
  "scripts": {
    "dev:android": "ionic cap run android --livereload --external --watch",
    "dev:a": "pnpm run dev:android",
    "dev:ios": "ionic cap run ios --livereload --external --watch",
    "dev:i": "pnpm run dev:ios",
    "dev": "vite",
    "devtools": "vue-devtools",
    "dt": "pnpm run devtools",
    "build:web": "pnpm i18n:extract && vue-tsc && vite build",
    "build:ios": "dotenv bundle exec fastlane ios beta",
    "build:android": "dotenv bundle exec fastlane android beta",
    "release": "pnpm i18n:sync && ionic cap build --prod",
    "release:beta": "pnpm i18n:sync && dotenv release-it",
    "release:browserstack": "dotenv node scripts/browserstack-upload.js",
    "release:bs": "pnpm release:browserstack",
    "preview": "vite preview",
    "postinstall": "/bin/bash -c 'cp -r ${PWD}/node_modules/@nimiq/core/{launcher,lib,web} ${PWD}/public/nimiq/'",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "i18n:extract": "node ./node_modules/webpack-i18n-tools/index.js ./src/i18n/en.po",
    "i18n:push": "./weblate-sync.sh --pushSource",
    "i18n:pull": "./weblate-sync.sh --pullTranslations=de,es,fr,pt",
    "i18n:sync": "pnpm i18n:extract && pnpm i18n:push && pnpm i18n:pull"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^8.0.2",
    "@aparajita/capacitor-secure-storage": "^6.0.1",
    "@capacitor-community/privacy-screen": "^5.2.1",
    "@capacitor/browser": "^6.0.4",
    "@capacitor/camera": "^6.0.2",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/share": "^6.0.3",
    "@capawesome/capacitor-screen-orientation": "^6.0.1",
    "@capgo/camera-preview": "^6.5.28",
    "@nimiq/fastspot-api-v1": "npm:@nimiq/fastspot-api@^1.10.3",
    "@nimiq/fastspot-api-v2": "npm:@nimiq/fastspot-api@2.0.0-beta.0",
    "@nimiq/utils": "^0.12.3",
    "@nimiq/vue3-components": "github:nimiq/vue3-components#build/full",
    "@rdlabo/capacitor-screenshot-event": "^6.0.0",
    "@vueuse/core": "^12.3.0",
    "@vueuse/integrations": "^12.3.0",
    "bech32": "^2.0.0",
    "capacitor-monetplus-hce": "link:../capacitor-monetplus-hce",
    "capacitor-sumsub-mobile-sdk": "^0.0.1",
    "fuse.js": "^7.0.0",
    "jsencrypt": "^3.3.2",
    "jssha": "^3.3.1",
    "libphonenumber-js": "^1.11.17",
    "light-bolt11-decoder": "^3.1.1",
    "pinia": "^2.3.0",
    "qr-scanner-wechat": "^0.1.3",
    "radix-vue": "^1.9.12",
    "valibot": "^1.0.0-beta.14",
    "vue-virtual-scroller": "2.0.0-beta.8",
    "youtube-player": "^5.6.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.13.0",
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/clipboard": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/push-notifications": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@iconify-json/nimiq": "https://pkg.pr.new/onmax/nimiq-ui/nimiq-icons@2c34cae",
    "@ionic/cli": "^7.2.0",
    "@ionic/core": "8.4.1",
    "@ionic/vue": "8.4.1",
    "@ionic/vue-router": "8.4.1",
    "@nimiq/core": "^2.0.9",
    "@types/youtube-player": "^5.5.11",
    "@vitejs/plugin-legacy": "^6.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/devtools": "^7.7.0",
    "@vue/eslint-config-typescript": "^14.2.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "cypress": "^13.17.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-vue": "^9.32.0",
    "ionicons": "^7.4.0",
    "jeep-sqlite": "2.8.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.49",
    "release-it": "^18.1.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-nimiq-theme": "^0.2.2",
    "terser": "^5.37.0",
    "typescript": "^5.7.3",
    "unplugin-icons": "^22.0.0",
    "unplugin-vue-components": "^28.1.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-top-level-await": "^1.4.1",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0",
    "webpack-i18n-tools": "github:nimiq/webpack-i18n-tools"
  },
  "pnpm": {
    "overrides": {
      "jeep-sqlite": "2.5.6"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "bufferutil",
      "core-js",
      "cypress",
      "electron",
      "es5-ext",
      "esbuild",
      "sharp",
      "utf-8-validate",
      "vue-demi"
    ]
  }
}
