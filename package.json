{
  "name": "nimiq-pay",
  "type": "module",
  "version": "2.22.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Self-custody mobile wallet for paying with NIM and USDT",
  "scripts": {
    "dev:android": "ionic cap run android --livereload --external --watch",
    "dev:a": "pnpm run dev:android",
    "dev:ios": "ionic cap run ios --livereload --external --watch",
    "dev:i": "pnpm run dev:ios",
    "dev": "vite",
    "dev:htlc-lab": "pnpm --dir tools/htlc-lab dev",
    "devtools": "vue-devtools",
    "dt": "pnpm run devtools",
    "build:web": "pnpm i18n:extract && vue-tsc && vite build",
    "build:ios": "dotenv bundle exec fastlane ios beta",
    "build:android": "dotenv bundle exec fastlane android beta",
    "screenshots:ios": "dotenv bundle exec fastlane ios screenshots",
    "screenshots:android": "dotenv bundle exec fastlane android screenshots",
    "screenshots:previews": "node scripts/store-preview-server.mjs --open",
    "build:web3-provider": "node scripts/build-web3-provider.mjs",
    "release": "pnpm i18n:sync && ionic cap build --prod",
    "release:beta": "pnpm i18n:sync && node scripts/release-beta.mjs",
    "changelog": "node scripts/generate-changelog.mjs",
    "release:browserstack": "dotenv node scripts/browserstack-upload.js",
    "release:bs": "pnpm release:browserstack",
    "release:browserstack:apk": "dotenv node scripts/browserstack-apk-upload.js",
    "release:bs:apk": "pnpm release:browserstack:apk",
    "upload:browserstack:maestro": "node scripts/browserstack-maestro-upload.js",
    "run:browserstack:maestro": "node scripts/browserstack-maestro-run.js",
    "preview": "vite preview",
    "copy:nimiq": "/bin/bash -c 'cp -r ${PWD}/node_modules/@nimiq/core/{launcher,lib,web} ${PWD}/public/nimiq/'",
    "postinstall": "pnpm copy:nimiq && pnpm build:web3-provider",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "pnpm test:maestro",
    "test:maestro": "maestro test -e APP_ID=com.nimiq.pay.debug -e PIN=1111 nimiq-pay-tests/run_all.yaml",
    "test:maestro:all": "maestro test -e APP_ID=com.nimiq.pay.debug -e PIN=1111 nimiq-pay-tests/flows/",
    "test:unit": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "i18n:extract": "node ./node_modules/webpack-i18n-tools/index.js ./src/i18n/en.po",
    "i18n:push": "./weblate-sync.sh --pushSource",
    "i18n:pull": "./weblate-sync.sh --pullTranslations=de,es,fr,pt",
    "i18n:sync": "pnpm i18n:extract && pnpm i18n:push && pnpm i18n:pull"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/privacy-screen": "^2.0.1",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/toast": "^8.0.1",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
    "@capawesome/capacitor-posthog": "^8.6.2",
    "@capgo/camera-preview": "^8.11.6",
    "@capgo/capacitor-inappbrowser": "^8.21.1",
    "@capgo/capacitor-updater": "^8.52.1",
    "@internationalized/number": "^3.6.8",
    "@nimiq/fastspot-api-v1": "npm:@nimiq/fastspot-api@^1.10.3",
    "@nimiq/fastspot-api-v2": "npm:@nimiq/fastspot-api@2.0.0-beta.2",
    "@nimiq/utils": "^0.12.4",
    "@nimiq/vue3-components": "github:nimiq/vue3-components#build/full",
    "@opengsn/common": "^2.2.6",
    "@rdlabo/capacitor-screenshot-event": "^8.0.0",
    "@vueuse/components": "^14.4.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "bech32": "^2.0.0",
    "birpc": "^4.2.0",
    "buffer": "5.7.1",
    "capacitor-extended-dialog": "^0.0.16",
    "capacitor-lockdown-mode": "0.0.1",
    "ethers": "^6.17.0",
    "fuse.js": "^7.5.0",
    "jsencrypt": "3.3.2",
    "jssha": "^3.3.2",
    "libphonenumber-js": "^1.13.14",
    "light-bolt11-decoder": "^3.2.0",
    "motion-v": "^2.6.0",
    "pinia": "^3.0.4",
    "posthog-js": "^1.436.1",
    "process": "0.11.10",
    "qr-scanner-wechat": "^0.1.3",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.11.0",
    "valibot": "^1.5.0",
    "vue-virtual-scroller": "2.0.0-beta.8",
    "youtube-player": "^5.6.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.3.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/cli": "^8.71.0",
    "@ionic/cli": "^7.2.1",
    "@ionic/core": "8.8.6",
    "@ionic/vue": "8.8.6",
    "@ionic/vue-router": "8.8.6",
    "@nimiq/core": "^2.22.0",
    "@types/youtube-player": "^5.5.11",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/devtools": "^8.2.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "bun": "1.3.6",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-format": "^1.5.0",
    "eslint-plugin-vue": "^10.11.1",
    "ionicons": "^8.1.0",
    "jeep-sqlite": "2.5.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.29",
    "release-it": "^19.2.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-nimiq-theme": "^0.2.2",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.2.7",
    "vue": "^3.5.43",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.12",
    "webpack-i18n-tools": "github:nimiq/webpack-i18n-tools"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "pnpm": {
    "overrides": {
      "jeep-sqlite": "2.5.6",
      "@swc/core": "1.15.33",
      "@swc/wasm": "1.15.33"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "@web3-js/scrypt-shim",
      "@web3-js/websocket",
      "bufferutil",
      "bun",
      "core-js",
      "electron",
      "es5-ext",
      "esbuild",
      "keccak",
      "protobufjs",
      "secp256k1",
      "sharp",
      "utf-8-validate",
      "vue-demi"
    ],
    "ignoredBuiltDependencies": [
      "@web3-js/websocket"
    ],
    "patchedDependencies": {
      "randombytes@2.1.0": "patches/randombytes@2.1.0.patch"
    }
  }
}
