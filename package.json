{
  "name": "nimiq-pay",
  "type": "module",
  "version": "2.10.0",
  "private": true,
  "description": "An Ionic project",
  "scripts": {
    "dev:android": "ionic cap run android --livereload --external --watch",
    "dev:a": "pnpm run dev:android",
    "dev:ios": "ionic cap run ios --livereload --external --watch",
    "dev:i": "pnpm run dev:ios",
    "dev": "vite",
    "devtools": "vue-devtools",
    "dt": "pnpm run devtools",
    "build:web": "pnpm i18n:extract && vue-tsc && vite build",
    "build:ios": "dotenv bundle exec fastlane ios beta",
    "build:android": "dotenv bundle exec fastlane android beta",
    "build:web3-provider": "pnpm --dir web3-provider install && pnpm --dir web3-provider build",
    "release": "pnpm i18n:sync && ionic cap build --prod",
    "release:beta": "pnpm i18n:sync && dotenv release-it",
    "release:browserstack": "dotenv node scripts/browserstack-upload.js",
    "release:bs": "pnpm release:browserstack",
    "preview": "vite preview",
    "copy:nimiq": "/bin/bash -c 'cp -r ${PWD}/node_modules/@nimiq/core/{launcher,lib,web} ${PWD}/public/nimiq/'",
    "postinstall": "pnpm copy:nimiq && pnpm build:web3-provider",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "cypress run",
    "test:maestro": "maestro test nimiq-pay-tests/run_all.yaml",
    "test:maestro:all": "maestro test nimiq-pay-tests/flows/",
    "test:unit": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "i18n:extract": "node ./node_modules/webpack-i18n-tools/index.js ./src/i18n/en.po",
    "i18n:push": "./weblate-sync.sh --pushSource",
    "i18n:pull": "./weblate-sync.sh --pullTranslations=de,es,fr,pt",
    "i18n:sync": "pnpm i18n:extract && pnpm i18n:push && pnpm i18n:pull"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.0.0",
    "@aparajita/capacitor-secure-storage": "^7.1.3",
    "@apps/capacitor-monetplus-hce": "^1.0.10",
    "@capacitor-community/privacy-screen": "^6.0.0",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/device": "^7.0.2",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^7.0.2",
    "@capacitor/toast": "^8.0.0",
    "@capawesome/capacitor-android-edge-to-edge-support": "^7.2.3",
    "@capawesome/capacitor-posthog": "^8.2.1",
    "@capgo/camera-preview": "^7.15.0",
    "@capgo/inappbrowser": "^8.3.0",
    "@internationalized/number": "^3.6.5",
    "@nimiq/fastspot-api-v1": "npm:@nimiq/fastspot-api@^1.10.3",
    "@nimiq/fastspot-api-v2": "npm:@nimiq/fastspot-api@2.0.0-beta.2",
    "@nimiq/utils": "^0.12.4",
    "@nimiq/vue3-components": "github:nimiq/vue3-components#build/full",
    "@opengsn/common": "^2.2.5",
    "@rdlabo/capacitor-screenshot-event": "^7.0.0",
    "@vueuse/components": "^14.2.1",
    "@vueuse/core": "^13.9.0",
    "@vueuse/integrations": "^13.9.0",
    "bech32": "^2.0.0",
    "birpc": "^4.0.0",
    "buffer": "5.7.1",
    "capacitor-extended-dialog": "^0.0.13",
    "capacitor-sumsub-mobile-sdk": "^0.0.6",
    "ethers": "^6.16.0",
    "fuse.js": "^7.1.0",
    "jsencrypt": "3.3.2",
    "jssha": "^3.3.1",
    "libphonenumber-js": "^1.12.15",
    "light-bolt11-decoder": "^3.2.0",
    "motion-v": "^1.7.1",
    "pinia": "^3.0.3",
    "posthog-js": "^1.352.0",
    "process": "0.11.10",
    "qr-scanner-wechat": "^0.1.3",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.6.0",
    "valibot": "^1.0.0-beta.14",
    "vue-virtual-scroller": "2.0.0-beta.8",
    "youtube-player": "^5.6.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.3.0",
    "@capacitor-community/sqlite": "^7.0.1",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/clipboard": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/push-notifications": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@ionic/cli": "^7.2.1",
    "@ionic/core": "8.7.3",
    "@ionic/vue": "8.7.3",
    "@ionic/vue-router": "8.7.3",
    "@nimiq/core": "^2.2.2",
    "@types/youtube-player": "^5.5.11",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/devtools": "^8.0.2",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "cypress": "^15.2.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-vue": "^10.4.0",
    "ionicons": "^8.0.13",
    "jeep-sqlite": "2.5.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "release-it": "^19.0.4",
    "tailwindcss": "^3.4.17",
    "tailwindcss-nimiq-theme": "^0.2.2",
    "terser": "^5.44.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.21",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.0.6",
    "webpack-i18n-tools": "github:nimiq/webpack-i18n-tools"
  },
  "pnpm": {
    "overrides": {
      "jeep-sqlite": "2.5.6"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "@web3-js/scrypt-shim",
      "@web3-js/websocket",
      "bufferutil",
      "core-js",
      "cypress",
      "electron",
      "es5-ext",
      "esbuild",
      "keccak",
      "protobufjs",
      "secp256k1",
      "sharp",
      "utf-8-validate",
      "vue-demi"
    ],
    "ignoredBuiltDependencies": [
      "@web3-js/websocket"
    ],
    "patchedDependencies": {
      "randombytes@2.1.0": "patches/randombytes@2.1.0.patch"
    }
  }
}
