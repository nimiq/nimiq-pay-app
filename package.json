{
  "name": "nimiq-pay",
  "type": "module",
  "version": "1.3.5",
  "private": true,
  "description": "An Ionic project",
  "scripts": {
    "dev:android": "ionic cap run android --livereload --external --watch",
    "dev:a": "pnpm run dev:android",
    "dev:ios": "ionic cap run ios --livereload --external --watch",
    "dev:i": "pnpm run dev:ios",
    "dev": "vite",
    "devtools": "vue-devtools",
    "dt": "pnpm run devtools",
    "build:web": "pnpm i18n:extract && vue-tsc && vite build",
    "build:ios": "dotenv bundle exec fastlane ios beta",
    "build:android": "dotenv bundle exec fastlane android beta",
    "release": "pnpm i18n:sync && ionic cap build --prod",
    "release:beta": "pnpm i18n:sync && dotenv release-it",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "i18n:extract": "node ./node_modules/webpack-i18n-tools/index.js ./src/i18n/en.po",
    "i18n:push": "./weblate-sync.sh --pushSource",
    "i18n:pull": "./weblate-sync.sh --pullTranslations=de,es,fr,pt",
    "i18n:sync": "pnpm i18n:extract && pnpm i18n:push && pnpm i18n:pull"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^8.0.2",
    "@aparajita/capacitor-secure-storage": "^6.0.1",
    "@capacitor-mlkit/barcode-scanning": "^6.2.0",
    "@capacitor/browser": "^6.0.3",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/share": "^6.0.2",
    "@capawesome/capacitor-screen-orientation": "^6.0.1",
    "@nimiq/fastspot-api-v1": "npm:@nimiq/fastspot-api@^1.9.0",
    "@nimiq/fastspot-api-v2": "npm:@nimiq/fastspot-api@2.0.0-beta.0",
    "@nimiq/utils": "^0.11.7",
    "@nimiq/vue3-components": "github:nimiq/vue3-components#build/full",
    "@vueuse/core": "^11.2.0",
    "@vueuse/integrations": "^11.2.0",
    "bech32": "^2.0.0",
    "fuse.js": "^7.0.0",
    "jssha": "^3.3.1",
    "libphonenumber-js": "^1.11.14",
    "light-bolt11-decoder": "^3.1.1",
    "pinia": "^2.2.6",
    "qr-scanner-wechat": "^0.1.3",
    "radix-vue": "^1.9.9",
    "vue-virtual-scroller": "2.0.0-beta.8",
    "youtube-player": "^5.6.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "1.0.0-beta.29",
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/clipboard": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/push-notifications": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@ionic/cli": "^7.2.0",
    "@ionic/core": "8.4.0",
    "@ionic/vue": "8.4.0",
    "@ionic/vue-router": "8.4.0",
    "@nimiq/core-web": "^1.6.3",
    "@types/youtube-player": "^5.5.11",
    "@vitejs/plugin-legacy": "^5.4.3",
    "@vitejs/plugin-vue": "^5.1.5",
    "@vue/devtools": "^7.6.4",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "cypress": "^13.15.2",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-format": "^0.1.2",
    "eslint-plugin-vue": "^9.30.0",
    "ionicons": "^7.4.0",
    "jeep-sqlite": "2.5.6",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "release-it": "^17.10.0",
    "tailwindcss": "^3.4.14",
    "tailwindcss-nimiq-theme": "^0.2.2",
    "terser": "^5.36.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.4",
    "vue": "^3.5.12",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.4.5",
    "vue-tsc": "^2.1.10",
    "webpack-i18n-tools": "github:nimiq/webpack-i18n-tools"
  },
  "pnpm": {
    "overrides": {
      "jeep-sqlite": "2.5.6"
    }
  }
}
