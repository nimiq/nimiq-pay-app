{
  "name": "nimiq-pay",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "An Ionic project",
  "scripts": {
    "dev:android": "ionic cap run android --livereload --external --watch",
    "dev:a": "pnpm run dev:android",
    "dev:ios": "ionic cap run ios --livereload --external --watch",
    "dev:i": "pnpm run dev:ios",
    "dev": "vite",
    "devtools": "vue-devtools",
    "dt": "pnpm run devtools",
    "build": "pnpm i18n:extract && vue-tsc && vite build",
    "release": "pnpm i18n:extract && ionic cap build --prod",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "lint": "eslint src",
    "i18n:extract": "node ./node_modules/webpack-i18n-tools/index.js ./src/i18n/en.po",
    "i18n:push": "./weblate-sync.sh --pushSource",
    "i18n:pull": "./weblate-sync.sh --pullTranslations=de",
    "i18n:sync": "pnpm i18n:extract && pnpm i18n:push && pnpm i18n:pull"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^5.3.0",
    "@capacitor/browser": "^5.2.0",
    "@capacitor/filesystem": "^5.2.1",
    "@capacitor/share": "^5.0.7",
    "@capawesome/capacitor-screen-orientation": "^5.0.1",
    "@nimiq/utils": "^0.9.3",
    "@nimiq/vue3-components": "github:nimiq/vue3-components#build/full",
    "@vueuse/core": "^10.7.2",
    "@vueuse/integrations": "^10.7.2",
    "fuse.js": "^7.0.0",
    "jssha": "^3.3.1",
    "libphonenumber-js": "^1.10.55",
    "pinia": "^2.1.7",
    "qr-scanner-wechat": "^0.1.3",
    "radix-vue": "^1.4.2",
    "vue-virtual-scroller": "2.0.0-beta.8",
    "youtube-player": "^5.6.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "1.0.0-beta.29",
    "@capacitor-community/sqlite": "^5.5.1-2",
    "@capacitor/android": "^5.7.0",
    "@capacitor/app": "^5.0.7",
    "@capacitor/assets": "^3.0.4",
    "@capacitor/cli": "^5.7.0",
    "@capacitor/clipboard": "^5.0.7",
    "@capacitor/core": "^5.7.0",
    "@capacitor/haptics": "^5.0.7",
    "@capacitor/ios": "^5.7.0",
    "@capacitor/keyboard": "^5.0.8",
    "@capacitor/push-notifications": "^5.1.1",
    "@capacitor/status-bar": "^5.0.7",
    "@ionic/cli": "^7.2.0",
    "@ionic/core": "^7.7.1",
    "@ionic/vue": "^7.7.1",
    "@ionic/vue-router": "^7.7.1",
    "@nimiq/core-web": "^1.6.2",
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/youtube-player": "^5.5.11",
    "@vitejs/plugin-legacy": "^5.3.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vue/devtools": "^7.0.15",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.4",
    "autoprefixer": "^10.4.17",
    "cypress": "^13.6.4",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.21.1",
    "ionicons": "^7.2.2",
    "jeep-sqlite": "2.5.8",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tailwindcss-nimiq-theme": "^0.2.2",
    "terser": "^5.27.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vite-plugin-checker": "^0.6.4",
    "vite-plugin-pwa": "^0.17.5",
    "vitest": "^1.2.2",
    "vue": "^3.4.16",
    "vue-i18n": "^9.9.1",
    "vue-router": "^4.2.5",
    "vue-tsc": "^1.8.27",
    "webpack-i18n-tools": "github:nimiq/webpack-i18n-tools"
  },
  "pnpm": {
    "overrides": {
      "jeep-sqlite": "2.5.6"
    }
  }
}
